# --- TAJMA PRODUCTION ENVIRONMENT ---
ENV=production
DEBUG=False
SECRET_KEY=LNRJmEYhdgcZlVqtjXETTP+XUqkLgQNx8Rwqp520zJs= # Replace this with a fresh key for production!
ALLOWED_HOSTS=tajma.net,www.tajma.net,api.tajma.net

# Database Configuration (PostgreSQL via dj-database-url)
DATABASE_URL=postgres://postgres:your_secure_db_password@db:5432/tajma

# Redis Configuration (Required for Channels)
REDIS_HOST=redis # Service name in Docker/Coolify
REDIS_PORT=6379

# Site URLs
SITE_URL=https://api.tajma.net
FRONTEND_URL=https://tajma.net

# CORS and CSRF Configuration
CORS_ALLOWED_ORIGINS=https://tajma.net,https://www.tajma.net
CSRF_TRUSTED_ORIGINS=https://tajma.net,https://www.tajma.net
SESSION_COOKIE_DOMAIN=.tajma.net

# Cloudinary (Media Hosting)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Configuration (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=Tajma Marketplace <noreply@tajma.net>
