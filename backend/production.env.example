# --- TAJMA PRODUCTION ENVIRONMENT TEMPLATE ---
# Copy this file to .env and fill in the values for production deployment.

# Django Core
SECRET_KEY=your-super-secret-key-for-production
DEBUG=False
ENV=production
ALLOWED_HOSTS=tajma.net,www.tajma.net

# Database (PostgreSQL recommended for production)
DATABASE_URL=postgres://user:password@host:port/dbname

# Redis (Required for Django Channels WebSockets in production)
REDIS_HOST=localhost
REDIS_PORT=6379

# Site URLs
SITE_URL=https://tajma.net
FRONTEND_URL=https://tajma.net

# CORS & CSRF
CSRF_TRUSTED_ORIGINS=https://tajma.net,https://www.tajma.net
SESSION_COOKIE_DOMAIN=.tajma.net

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=Tajma Marketplace <noreply@tajma.net>

# Cloudinary (Image Hosting & CDN)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Paystack (Payments)
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxx

# Smile ID (KYC Verification)
SMILE_ID_PARTNER_ID=your-partner-id
SMILE_ID_API_KEY=your-api-key
SMILE_ID_SANDBOX=False
SMILE_ID_CONFIG_PATH=/path/to/smile_config.json

# Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Firebase Cloud Messaging (Push Notifications)
FIREBASE_SERVICE_ACCOUNT_JSON=/path/to/firebase-credentials.json
