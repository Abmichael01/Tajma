{
  "expo": {
    "name": "Tajma",
    "slug": "tajma",
    "scheme": "tajma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.tajma.app",
      "associatedDomains": [
        "applinks:tajma.net",
        "applinks:www.tajma.net"
      ],
      "splash": {
        "image": "./assets/splash-logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      }
    },
    "android": {
      "package": "net.tajma.app",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tajma.net",
              "pathPrefix": "/ads"
            },
            {
              "scheme": "https",
              "host": "www.tajma.net",
              "pathPrefix": "/ads"
            }
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF4F18"
      },
      "splash": {
        "image": "./assets/splash-logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Tajma to use your location to place your ad on the map and show nearby details."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF4F18",
          "sounds": ["./assets/sounds/notification.wav"]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Tajma to access your microphone to record and send voice notes."
        }
      ],
      "expo-font",
      "expo-video",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Tajma to access your photos to upload listing images and profile avatars."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "358921d0-eb7f-4cb0-9a2a-ab6f73c3674c"
      }
    }
  }
}
