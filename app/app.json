{
  "expo": {
    "name": "Tajma",
    "slug": "tajma",
    "scheme": "tajma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.urkelcodes.tajma",
      "associatedDomains": [
        "applinks:tajma.net",
        "applinks:www.tajma.net"
      ],
      "splash": {
        "image": "./assets/splash-logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      }
    },
    "android": {
      "package": "com.urkelcodes.tajma",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tajma.net",
              "pathPrefix": "/ads"
            },
            {
              "scheme": "https",
              "host": "www.tajma.net",
              "pathPrefix": "/ads"
            }
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF4F18"
      },
      "splash": {
        "image": "./assets/splash-logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Tajma to use your location to place your ad on the map and show nearby details."
        }
      ],
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Tajma to access your microphone to record and send voice notes."
        }
      ],
      "expo-font",
      "expo-video",
      "expo-asset",
      "@sentry/react-native"
    ]
  }
}
